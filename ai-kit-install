# Color codes
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

log() {
  printf "${BLUE}[ai-kit]${NC} %s\n" "$*" >&2
}

log_ok() {
  printf "${GREEN}[OK]${NC} %s\n" "$*" >&2
}

log_warn() {
  printf "${YELLOW}[!]${NC} %s\n" "$*" >&2
}

log_error() {
  printf "${RED}[X]${NC} %s\n" "$*" >&2
}

die() {
  log_error "$*"
  exit 1
}

COMMAND="install"
TAG="latest"
DRY_RUN=false
VERBOSE=false
SKIP_VERIFY="${SKIP_VERIFY:-false}"
NO_PROMPT=false
PROVIDER_CHOICE=""
INSTALL_FRIEREN="${INSTALL_FRIEREN:-}"  # "": ask interactively; "true": yes; "false": skip
FRIEREN_DIR="${FRIEREN_DIR:-$HOME/dev/frieren}"
INSTALL_SHADE="${INSTALL_SHADE:-}"      # "": ask interactively; "true": yes; "false": skip
SHADE_DIR="${SHADE_DIR:-$HOME/.config/opencode/shade-pico}"
CUSTOMIZE_MODELS="${CUSTOMIZE_MODELS:-}"  # "": ask interactively; "true": go straight to per-agent prompts; "false": use defaults

# Auto-run detection: if no command given and no existing installation,
# automatically run 'install' command
if [ $# -eq 0 ]; then
  TARGET_DIR_CHECK="$HOME/.config/opencode"
  if [ ! -d "$TARGET_DIR_CHECK" ]; then
    COMMAND="install"
  fi
fi

# Parse flags anywhere; accept: <command> [tag]
POSITIONAL=()
while [ $# -gt 0 ]; do
  case "$1" in
  -v | --verbose)
    VERBOSE=true
    shift
    ;;
  -h | --help | help)
    POSITIONAL=("help")
    shift
    ;;
  --no-prompt)
    NO_PROMPT=true
    shift
    ;;
  --provider)
    if [ -z "${2:-}" ]; then
      die "--provider requires a value: aitooling or copilot"
    fi
    PROVIDER_CHOICE="$2"
    shift 2
    ;;
  --frieren)
    INSTALL_FRIEREN="true"
    shift
    ;;
  --no-frieren)
    INSTALL_FRIEREN="false"
    shift
    ;;
  --shade)
    INSTALL_SHADE="true"
    shift
    ;;
  --no-shade)
    INSTALL_SHADE="false"
    shift
    ;;
  --models)
    CUSTOMIZE_MODELS="true"
    shift
    ;;
  --frieren-path)
    if [ -z "${2:-}" ]; then
      die "--frieren-path requires a value"
    fi
    FRIEREN_DIR="$2"
    shift 2
    ;;
  --)
    shift
    break
    ;;
  *)
    POSITIONAL+=("$1")
    shift
    ;;
  esac
done

COMMAND="${POSITIONAL[0]:-install}"
TAG="${POSITIONAL[1]:-latest}"

get_env_file_key() {
  local env_file="$TARGET_DIR/.env"
  local key_name="${1:-AITOOLINGKEY}"

  if [ ! -f "$env_file" ]; then
    return 0
  fi

  local line
  line="$(grep -E "^${key_name}=" "$env_file" 2>/dev/null | tail -1 || true)"
  if [ -z "$line" ]; then
    return 0
  fi

  printf "%s" "${line#${key_name}=}"
}

write_env_key() {
  local key_name="$1"
  local key_value="$2"
  local env_file="$TARGET_DIR/.env"

  if [ -L "$env_file" ]; then
    die "Refusing to write to symlink: $env_file"
  fi

  mkdir -p "$TARGET_DIR"
  touch "$env_file"
  chmod 600 "$env_file" 2>/dev/null || true

  local tmp
  tmp="$(mktemp)"

  # Copy existing .env while removing any prior entries for this key
  while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in
    "${key_name}"=*)
      continue
      ;;
    esac
    printf "%s\n" "$line" >>"$tmp"
  done <"$env_file"

  printf "%s=%s\n" "$key_name" "$key_value" >>"$tmp"
  mv "$tmp" "$env_file"
  chmod 600 "$env_file" 2>/dev/null || true
}

# Append export statement to user's shell rc file
add_to_rc_file() {
  local key_name="$1"
  local key_value="$2"

  # Determine which rc file to use
  local rc_file=""
  if [ -n "${ZSH_VERSION:-}" ]; then
    rc_file="$HOME/.zshrc"
  elif [ -n "${BASH_VERSION:-}" ]; then
    rc_file="$HOME/.bashrc"
  elif [ -f "$HOME/.zshrc" ]; then
    rc_file="$HOME/.zshrc"
  elif [ -f "$HOME/.bashrc" ]; then
    rc_file="$HOME/.bashrc"
  else
    rc_file="$HOME/.profile"
  fi

  # Check if export already exists
  if grep -qE "^export ${key_name}=" "$rc_file" 2>/dev/null; then
    log "Export already exists in $rc_file"
    return 0
  fi

  if [ "$DRY_RUN" = true ]; then
    log "Dry run: would add export ${key_name}=... to $rc_file"
    return 0
  fi

  # Append export statement
  printf "\nexport %s=\"%s\"\n" "$key_name" "$key_value" >>"$rc_file"
  log_ok "Added export to $rc_file"
}

# ---------------------------------------------------------------------------
# Provider selection and agent model configuration
# ---------------------------------------------------------------------------

validate_provider() {
  case "$1" in
  aitooling | copilot) return 0 ;;
  *) die "Invalid provider '$1'. Must be 'aitooling' or 'copilot'." ;;
  esac
}

# Returns the default model ID for a given provider + agent role.
# Per-agent smart defaults: GPT/Anthropic mix for copilot; Sonnet/Haiku for aitooling.
get_default_agent_model() {
  local provider="$1" agent="$2"
  case "$provider/$agent" in
  aitooling/architect)   echo "aitooling/claude-sonnet-4-6" ;;
  aitooling/strategist)  echo "aitooling/claude-sonnet-4-6" ;;
  aitooling/implementer) echo "aitooling/claude-sonnet-4-6" ;;
  aitooling/reviewer)    echo "aitooling/claude-haiku-4-5-20251001" ;;
  aitooling/research)    echo "aitooling/claude-haiku-4-5-20251001" ;;
  copilot/architect)     echo "github-copilot/claude-opus-4.6" ;;
  copilot/strategist)    echo "github-copilot/claude-opus-4.6" ;;
  copilot/implementer)   echo "github-copilot/gpt-5.3-codex" ;;
  copilot/reviewer)      echo "github-copilot/claude-sonnet-4.6" ;;
  copilot/research)      echo "github-copilot/gpt-5.4" ;;
  *)                     echo "" ;;
  esac
}

# Prompt (or read saved values) to optionally customise per-agent model assignments.
# Saves choices to .env as AGENT_MODEL_<NAME> for reuse on future updates.
select_agent_models() {
  local agents=("architect" "strategist" "implementer" "reviewer" "research")

  # Load any previously saved per-agent overrides from .env
  local -A saved_models=()
  for agent in "${agents[@]}"; do
    local key="AGENT_MODEL_$(echo "$agent" | tr '[:lower:]' '[:upper:]')"
    local saved
    saved="$(get_env_file_key "$key" || true)"
    if [ -n "$saved" ]; then
      saved_models["$agent"]="$saved"
    fi
  done

  # Determine whether to customise
  local do_customize=false

  if [ "$CUSTOMIZE_MODELS" = "true" ]; then
    do_customize=true
  elif [ "$CUSTOMIZE_MODELS" = "false" ] || [ "$DRY_RUN" = true ] || [ "$NO_PROMPT" = true ] || [ ! -t 0 ]; then
    do_customize=false
  elif [ "${#saved_models[@]}" -gt 0 ]; then
    # Saved overrides exist — ask whether to keep or reconfigure
    printf "\n" >&2
    printf "┌─────────────────────────────────────────────────────────────────┐\n" >&2
    printf "│  Custom agent models are saved from a previous install.         │\n" >&2
    printf "│  Reconfigure agent models? [y/N]                                │\n" >&2
    printf "└─────────────────────────────────────────────────────────────────┘\n" >&2
    printf "  Choice: " >&2
    local answer
    IFS= read -r answer
    [[ "$answer" =~ ^[Yy]$ ]] && do_customize=true
  else
    # No saved overrides — offer customisation
    printf "\n" >&2
    printf "┌─────────────────────────────────────────────────────────────────┐\n" >&2
    printf "│  Customise agent model assignments? [y/N]                       │\n" >&2
    printf "│  (Press Enter to use smart defaults for $PROVIDER_CHOICE)       │\n" >&2
    printf "└─────────────────────────────────────────────────────────────────┘\n" >&2
    printf "  Choice: " >&2
    local answer
    IFS= read -r answer
    [[ "$answer" =~ ^[Yy]$ ]] && do_customize=true
  fi

  if [ "$do_customize" = false ]; then
    # Apply defaults (or saved overrides if they exist and user didn't reconfigure)
    for agent in "${agents[@]}"; do
      local key="AGENT_MODEL_$(echo "$agent" | tr '[:lower:]' '[:upper:]')"
      if [ -n "${saved_models[$agent]:-}" ]; then
        printf -v "AGENT_MODEL_${agent^^}" "%s" "${saved_models[$agent]}"
        log "  $agent: ${saved_models[$agent]} (saved)"
      else
        local default
        default="$(get_default_agent_model "$PROVIDER_CHOICE" "$agent")"
        printf -v "AGENT_MODEL_${agent^^}" "%s" "$default"
        log "  $agent: $default (default)"
      fi
    done
    return 0
  fi

  # Interactive per-agent customisation
  printf "\n" >&2
  printf "╔══════════════════════════════════════════════════════════════╗\n" >&2
  printf "║  Agent Model Configuration                                   ║\n" >&2
  printf "║  Provider: %-49s║\n" "$PROVIDER_CHOICE" >&2
  printf "║  Press Enter to accept the default for each agent.           ║\n" >&2
  printf "╚══════════════════════════════════════════════════════════════╝\n" >&2
  printf "\n" >&2

  for agent in "${agents[@]}"; do
    local default
    default="$(get_default_agent_model "$PROVIDER_CHOICE" "$agent")"
    local current="${saved_models[$agent]:-$default}"
    local key="AGENT_MODEL_$(echo "$agent" | tr '[:lower:]' '[:upper:]')"

    printf "  %-12s [default: %s]\n" "$agent" "$current" >&2
    printf "  Model: " >&2
    local choice
    IFS= read -r choice

    local selected
    if [ -z "$choice" ]; then
      selected="$current"
    else
      selected="$choice"
    fi

    printf -v "AGENT_MODEL_${agent^^}" "%s" "$selected"
    [ "$DRY_RUN" != true ] && write_env_key "$key" "$selected"
    log_ok "  $agent → $selected"
  done
}

# Prompt (or read saved value) to choose model provider
select_provider() {
  local env_provider
  env_provider="$(get_env_file_key "MODEL_PROVIDER" || true)"

  # Env var override takes priority
  if [ -n "${MODEL_PROVIDER:-}" ]; then
    PROVIDER_CHOICE="${MODEL_PROVIDER}"
    validate_provider "$PROVIDER_CHOICE"
    [ "$DRY_RUN" != true ] && write_env_key "MODEL_PROVIDER" "$PROVIDER_CHOICE"
    log_ok "Provider (from env): $PROVIDER_CHOICE"
    return 0
  fi

  # --provider flag already set
  if [ -n "$PROVIDER_CHOICE" ]; then
    validate_provider "$PROVIDER_CHOICE"
    [ "$DRY_RUN" != true ] && write_env_key "MODEL_PROVIDER" "$PROVIDER_CHOICE"
    log_ok "Provider (from flag): $PROVIDER_CHOICE"
    return 0
  fi

  # Already persisted in .env
  if [ -n "$env_provider" ]; then
    PROVIDER_CHOICE="$env_provider"
    log_ok "Provider (saved): $PROVIDER_CHOICE"
    return 0
  fi

  # Dry run default
  if [ "$DRY_RUN" = true ]; then
    PROVIDER_CHOICE="aitooling"
    log "Dry run: defaulting provider to aitooling"
    return 0
  fi

  if [ "$NO_PROMPT" = true ] || [ ! -t 0 ]; then
    die "MODEL_PROVIDER not set. Use --provider aitooling|copilot or set the MODEL_PROVIDER env var."
  fi

  printf "\n" >&2
  printf "╔══════════════════════════════════════════════════════════════╗\n" >&2
  printf "║  Model Provider Selection                                  ║\n" >&2
  printf "╠══════════════════════════════════════════════════════════════╣\n" >&2
  printf "║  1) aitooling  — uses your AITOOLINGKEY (LiteLLM gateway)  ║\n" >&2
  printf "║  2) copilot    — uses GitHub Copilot subscription          ║\n" >&2
  printf "╚══════════════════════════════════════════════════════════════╝\n" >&2
  printf "\n" >&2

  local choice
  while true; do
    printf "Select provider [1/2]: " >&2
    IFS= read -r choice
    case "$choice" in
    1 | aitooling)
      PROVIDER_CHOICE="aitooling"
      break
      ;;
    2 | copilot)
      PROVIDER_CHOICE="copilot"
      break
      ;;
    *)
      log_warn "Enter 1 (aitooling) or 2 (copilot)"
      ;;
    esac
  done

  write_env_key "MODEL_PROVIDER" "$PROVIDER_CHOICE"
  log_ok "Provider selected: $PROVIDER_CHOICE"
}

# Patch opencode.json in version_dir with per-agent model IDs.
# Must be called AFTER select_agent_models and BEFORE compute_manifest
# so the patched state is the baseline for future update detection.
configure_agent_models() {
  local version_dir="$1"
  local json_file="$version_dir/opencode.json"

  if [ "$DRY_RUN" = true ]; then
    log "Dry run: would configure agent models for provider=$PROVIDER_CHOICE"
    return 0
  fi

  if [ ! -f "$json_file" ]; then
    log_warn "opencode.json not found at $json_file — skipping model configuration"
    return 0
  fi

  if ! command -v jq >/dev/null 2>&1; then
    log_warn "jq not found — skipping automatic agent model configuration"
    log_warn "Install jq and re-run, or manually set agent models in $json_file"
    return 0
  fi

  local tmp
  tmp="$(mktemp)"

  jq \
    --arg architect   "${AGENT_MODEL_ARCHITECT:-}" \
    --arg strategist  "${AGENT_MODEL_STRATEGIST:-}" \
    --arg implementer "${AGENT_MODEL_IMPLEMENTER:-}" \
    --arg reviewer    "${AGENT_MODEL_REVIEWER:-}" \
    --arg research    "${AGENT_MODEL_RESEARCH:-}" \
    '.agent.architect.model   = $architect   |
     .agent.strategist.model  = $strategist  |
     .agent.implementer.model = $implementer |
     .agent.reviewer.model    = $reviewer    |
     .agent.research.model    = $research' \
    "$json_file" >"$tmp"

  mv "$tmp" "$json_file"
  log_ok "Agent models configured:"
  log "  architect:   ${AGENT_MODEL_ARCHITECT:-}"
  log "  strategist:  ${AGENT_MODEL_STRATEGIST:-}"
  log "  implementer: ${AGENT_MODEL_IMPLEMENTER:-}"
  log "  reviewer:    ${AGENT_MODEL_REVIEWER:-}"
  log "  research:    ${AGENT_MODEL_RESEARCH:-}"
}

ensure_aitoolingkey() {
  local env_key file_key env_base_url file_base_url
  env_key="${AITOOLINGKEY:-}"
  file_key="$(get_env_file_key "AITOOLINGKEY" || true)"
  env_base_url="${BASE_URL:-}"
  file_base_url="$(get_env_file_key "BASE_URL" || true)"

  # Check if we can prompt interactively
  local can_prompt=false
  if [ "$DRY_RUN" != true ] && [ "$NO_PROMPT" != true ] && [ -t 0 ]; then
    can_prompt=true
  fi

  # Handle AITOOLINGKEY
  if [ -n "$env_key" ]; then
    # Present in environment, persist it
    if [ "$DRY_RUN" = true ]; then
      log "Dry run: would persist AITOOLINGKEY to $TARGET_DIR/.env"
    elif [ "$file_key" != "$env_key" ]; then
      log "Persisting AITOOLINGKEY to $TARGET_DIR/.env"
      write_env_key "AITOOLINGKEY" "$env_key"
      add_to_rc_file "AITOOLINGKEY" "$env_key"
    fi
  elif [ -n "$file_key" ]; then
    # Already configured in .env — keep it silently
    log_ok "AITOOLINGKEY already configured (use 'write_env_key AITOOLINGKEY <value>' to change)"
  fi

  # Prompt for AITOOLINGKEY if still needed
  if [ -z "$env_key" ] && [ -z "$file_key" ]; then
    if [ "$DRY_RUN" = true ]; then
      log_warn "Dry run: AITOOLINGKEY missing; would prompt and write to $TARGET_DIR/.env"
    elif [ "$NO_PROMPT" = true ]; then
      die "AITOOLINGKEY is not set and no value found in $TARGET_DIR/.env. Prompting disabled (--no-prompt). Set env var AITOOLINGKEY or add it to $TARGET_DIR/.env."
    elif [ ! -t 0 ]; then
      die "AITOOLINGKEY is not set and no value found in $TARGET_DIR/.env. Non-interactive session: set env var AITOOLINGKEY or add it to $TARGET_DIR/.env."
    else
      # Interactive prompt
      log_warn "Configuration required"
      printf "\n" >&2
      printf "╔══════════════════════════════════════════════════════════════╗\n" >&2
      printf "║  AI Kit Configuration                                        ║\n" >&2
      printf "╠══════════════════════════════════════════════════════════════╣\n" >&2
      printf "║  Please enter your AITOOLINGKEY (API key)                    ║\n" >&2
      printf "║  Input will be hidden for security                           ║\n" >&2
      printf "╚══════════════════════════════════════════════════════════════╝\n" >&2
      printf "\n" >&2

      local entered
      entered=""
      while [ -z "$entered" ]; do
        printf "AITOOLINGKEY: " >&2
        IFS= read -r -s entered
        printf "\n" >&2

        if [ -z "$entered" ]; then
          log_warn "AITOOLINGKEY cannot be empty. Please try again."
        fi
      done

      write_env_key "AITOOLINGKEY" "$entered"
      log_ok "✓ Saved AITOOLINGKEY to $TARGET_DIR/.env"
      add_to_rc_file "AITOOLINGKEY" "$entered"
      env_key="$entered"
    fi
  fi

  # Handle BASE_URL (optional)
  if [ -n "$env_base_url" ]; then
    # Present in environment, persist it
    if [ "$DRY_RUN" = true ]; then
      log "Dry run: would persist BASE_URL to $TARGET_DIR/.env"
    elif [ "$file_base_url" != "$env_base_url" ]; then
      log "Persisting BASE_URL to $TARGET_DIR/.env"
      write_env_key "BASE_URL" "$env_base_url"
      add_to_rc_file "BASE_URL" "$env_base_url"
    fi
  elif [ -n "$file_base_url" ]; then
    # Already configured in .env — keep it silently
    log_ok "BASE_URL already configured: $file_base_url"
  fi

  # Prompt for BASE_URL if not set and we're interactive
  if [ -z "$env_base_url" ] && [ -z "$file_base_url" ] && [ "$can_prompt" = true ]; then
    printf "\n" >&2
    printf "BASE_URL (optional - press Enter to use default): " >&2
    local entered_url
    IFS= read -r entered_url

    if [ -n "$entered_url" ]; then
      write_env_key "BASE_URL" "$entered_url"
      add_to_rc_file "BASE_URL" "$entered_url"
      log_ok "✓ Saved BASE_URL to $TARGET_DIR/.env"
    else
      log "Using default BASE_URL from configuration"
    fi
  fi
}

# ---------------------------------------------------------------------------
# Frieren MCP server — optional local AI memory layer
# ---------------------------------------------------------------------------

check_frieren_in_config() {
  local config="$TARGET_DIR/opencode.json"
  [ -f "$config" ] || { echo "absent"; return; }
  if command -v jq &>/dev/null; then
    if jq -e '.mcp.frieren' "$config" &>/dev/null; then
      echo "configured"
    else
      echo "absent"
    fi
  else
    # grep fallback
    if grep -q '"mcp"' "$config" 2>/dev/null && grep -q '"frieren"' "$config" 2>/dev/null; then
      echo "configured"
    else
      echo "absent"
    fi
  fi
}

install_frieren_server() {
  if ! command -v git &>/dev/null; then
    log_warn "git not found — skipping Frieren server install"
    return 1
  fi
  if ! command -v bun &>/dev/null; then
    log_warn "bun not found — skipping Frieren server install"
    return 1
  fi
  if [ -d "$FRIEREN_DIR/.git" ]; then
    log "Updating Frieren server at $FRIEREN_DIR..."
    if [ "$DRY_RUN" != true ]; then
      git -C "$FRIEREN_DIR" pull --ff-only
    else
      log "[dry-run] git -C $FRIEREN_DIR pull --ff-only"
    fi
  else
    log "Cloning Frieren server to $FRIEREN_DIR..."
    if [ "$DRY_RUN" != true ]; then
      git clone https://github.com/krajh/frieren.git "$FRIEREN_DIR"
    else
      log "[dry-run] git clone https://github.com/krajh/frieren.git $FRIEREN_DIR"
    fi
  fi
  log "Installing Frieren dependencies..."
  if [ "$DRY_RUN" != true ]; then
    bun install --cwd "$FRIEREN_DIR"
    # On Linux, sharp (transitive dep of @xenova/transformers) requires a prebuilt native binary.
    # bun install does not build native modules by default, so install the prebuilt binary explicitly.
    if [ "$(uname -s)" = "Linux" ] && command -v npm &>/dev/null; then
      log "Installing sharp prebuilt binary for Linux..."
      npm install --prefix "$FRIEREN_DIR" --platform=linux --arch=x64 sharp@0.32.6 --silent \
        || log_warn "sharp install failed — if Frieren fails to start, run: npm install --platform=linux --arch=x64 sharp@0.32.6"
    fi
  else
    log "[dry-run] bun install --cwd $FRIEREN_DIR"
    log "[dry-run] npm install --platform=linux --arch=x64 sharp@0.32.6 (Linux only)"
  fi
}

configure_frieren_in_opencode() {
  if ! command -v jq &>/dev/null; then
    log_warn "jq not found — add Frieren manually to opencode.json:"
    log_warn '    "mcp": { "frieren": { "type": "local", "command": ["bun", "'"$FRIEREN_DIR"'/src/index.ts"], "enabled": true } }'
    return
  fi
  # Resolve symlink so we write the real file, not the symlink itself.
  # readlink -f is GNU-only; fall back to perl (available on macOS) then no-op.
  local real_config
  real_config="$(readlink -f "$TARGET_DIR/opencode.json" 2>/dev/null \
    || perl -MCwd -e 'print Cwd::abs_path(shift)' "$TARGET_DIR/opencode.json" 2>/dev/null \
    || echo "$TARGET_DIR/opencode.json")"
  if [ ! -f "$real_config" ]; then
    log_warn "opencode.json not found at $real_config — skipping Frieren config"
    return
  fi
  log "Configuring Frieren in opencode.json..."
  if [ "$DRY_RUN" != true ]; then
    local tmp
    tmp="$(mktemp)"
    jq --arg path "$FRIEREN_DIR/src/index.ts" \
      '.mcp.frieren = {"type":"local","command":["bun",$path],"enabled":true}' \
      "$real_config" > "$tmp" && mv "$tmp" "$real_config"
    log_ok "✓ Frieren configured in $real_config"
  else
    log "[dry-run] jq-patch .mcp.frieren into $real_config"
  fi
}

