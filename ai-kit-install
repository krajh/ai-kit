SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
TARGET_DIR="$HOME/.config/opencode"
BACKUP_ROOT="$HOME/.config/opencode.backups"
TIMESTAMP="$(date -u +%Y%m%d%H%M%SZ)"
BACKUP_PATH="$BACKUP_ROOT/ai-kit-$TIMESTAMP"
VERSIONS_DIR="$TARGET_DIR/versions"
CURRENT_LINK="$TARGET_DIR/current"
MANIFEST_FILE=".ai-kit-manifest.json"
INCOMING_DIR=".ai-kit-incoming"

# Top-level items that OpenCode reads from ~/.config/opencode.
# We keep the real content in versions/<tag>/ and expose it via symlinks.
KIT_LINK_ITEMS=(
  "opencode.json"
  "AGENTS.md"
  "agents"
  "plugins"
  "protocols"
  "skills"
)

# Cosign configuration
COSIGN_VERSION="v2.4.1"
COSIGN_SHA256="8b24b946dd5809c6bd93de08033bcf6bc0ed7d336b7785787c080f574b89249b"
COSIGN_OIDC_ISSUER="https://token.actions.githubusercontent.com"
COSIGN_IDENTITY_PREFIX="https://github.com/krajh/ai-kit/.github/workflows/release.yml@refs/tags/"

COMMAND="install"
TAG="latest"
DRY_RUN=false
VERBOSE=false
SKIP_VERIFY="${SKIP_VERIFY:-false}"
NO_PROMPT=false

# Parse flags anywhere; accept: <command> [tag]
POSITIONAL=()
while [ $# -gt 0 ]; do
  case "$1" in
  -v | --verbose)
    VERBOSE=true
    shift
    ;;
  -h | --help | help)
    POSITIONAL=("help")
    shift
    ;;
  --no-prompt)
    NO_PROMPT=true
    shift
    ;;
  --)
    shift
    break
    ;;
  *)
    POSITIONAL+=("$1")
    shift
    ;;
  esac
done

COMMAND="${POSITIONAL[0]:-install}"
TAG="${POSITIONAL[1]:-latest}"

# Color codes
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

log() {
  printf "${BLUE}[ai-kit]${NC} %s\n" "$*" >&2
}

log_ok() {
  printf "${GREEN}[OK]${NC} %s\n" "$*" >&2
}

log_warn() {
  printf "${YELLOW}[!]${NC} %s\n" "$*" >&2
}

log_error() {
  printf "${RED}[X]${NC} %s\n" "$*" >&2
}

die() {
  log_error "$*"
  exit 1
}

get_env_file_key() {
  local env_file="$TARGET_DIR/.env"
  local key_name="${1:-AITOOLINGKEY}"

  if [ ! -f "$env_file" ]; then
    return 0
  fi

  local line
  line="$(grep -E "^${key_name}=" "$env_file" 2>/dev/null | tail -1 || true)"
  if [ -z "$line" ]; then
    return 0
  fi

  printf "%s" "${line#${key_name}=}"
}

write_env_key() {
  local key_name="$1"
  local key_value="$2"
  local env_file="$TARGET_DIR/.env"

  if [ -L "$env_file" ]; then
    die "Refusing to write to symlink: $env_file"
  fi

  mkdir -p "$TARGET_DIR"
  touch "$env_file"
  chmod 600 "$env_file" 2>/dev/null || true

  local tmp
  tmp="$(mktemp)"

  # Copy existing .env while removing any prior entries for this key
  while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in
    "${key_name}"=*)
      continue
      ;;
    esac
    printf "%s\n" "$line" >>"$tmp"
  done <"$env_file"

  printf "%s=%s\n" "$key_name" "$key_value" >>"$tmp"
  mv "$tmp" "$env_file"
  chmod 600 "$env_file" 2>/dev/null || true
}

ensure_aitoolingkey() {
  local env_key file_key env_base_url file_base_url
  env_key="${AITOOLINGKEY:-}"
  file_key="$(get_env_file_key "AITOOLINGKEY" || true)"
  env_base_url="${BASE_URL:-}"
  file_base_url="$(get_env_file_key "BASE_URL" || true)"

  # Check if we can prompt interactively
  local can_prompt=false
  if [ "$DRY_RUN" != true ] && [ "$NO_PROMPT" != true ] && [ -t 0 ]; then
    can_prompt=true
  fi

  # Handle AITOOLINGKEY
  if [ -n "$env_key" ]; then
    # Present in environment, persist it
    if [ "$DRY_RUN" = true ]; then
      log "Dry run: would persist AITOOLINGKEY to $TARGET_DIR/.env"
    elif [ "$file_key" != "$env_key" ]; then
      log "Persisting AITOOLINGKEY to $TARGET_DIR/.env"
      write_env_key "AITOOLINGKEY" "$env_key"
    fi
  elif [ -n "$file_key" ]; then
    # Already configured in .env - confirm or keep
    if [ "$can_prompt" = true ]; then
      printf "AITOOLINGKEY is already configured. Keep existing value? [Y/n]: " >&2
      local response
      IFS= read -r response
      if [[ "$response" =~ ^[Nn]$ ]]; then
        env_key=""
        file_key=""
      fi
    fi
  fi

  # Prompt for AITOOLINGKEY if still needed
  if [ -z "$env_key" ] && [ -z "$file_key" ]; then
    if [ "$DRY_RUN" = true ]; then
      log_warn "Dry run: AITOOLINGKEY missing; would prompt and write to $TARGET_DIR/.env"
    elif [ "$NO_PROMPT" = true ]; then
      die "AITOOLINGKEY is not set and no value found in $TARGET_DIR/.env. Prompting disabled (--no-prompt). Set env var AITOOLINGKEY or add it to $TARGET_DIR/.env."
    elif [ ! -t 0 ]; then
      die "AITOOLINGKEY is not set and no value found in $TARGET_DIR/.env. Non-interactive session: set env var AITOOLINGKEY or add it to $TARGET_DIR/.env."
    else
      # Interactive prompt
      log_warn "Configuration required"
      printf "\n" >&2
      printf "╔══════════════════════════════════════════════════════════════╗\n" >&2
      printf "║  AI Kit Configuration                                        ║\n" >&2
      printf "╠══════════════════════════════════════════════════════════════╣\n" >&2
      printf "║  Please enter your AITOOLINGKEY (API key)                    ║\n" >&2
      printf "║  Input will be hidden for security                           ║\n" >&2
      printf "╚══════════════════════════════════════════════════════════════╝\n" >&2
      printf "\n" >&2

      local entered
      entered=""
      while [ -z "$entered" ]; do
        printf "AITOOLINGKEY: " >&2
        IFS= read -r -s entered
        printf "\n" >&2

        if [ -z "$entered" ]; then
          log_warn "AITOOLINGKEY cannot be empty. Please try again."
        fi
      done

      write_env_key "AITOOLINGKEY" "$entered"
      log_ok "✓ Saved AITOOLINGKEY to $TARGET_DIR/.env"
      env_key="$entered"
    fi
  fi

  # Handle BASE_URL (optional)
  if [ -n "$env_base_url" ]; then
    # Present in environment, persist it
    if [ "$DRY_RUN" = true ]; then
      log "Dry run: would persist BASE_URL to $TARGET_DIR/.env"
    elif [ "$file_base_url" != "$env_base_url" ]; then
      log "Persisting BASE_URL to $TARGET_DIR/.env"
      write_env_key "BASE_URL" "$env_base_url"
    fi
  elif [ -n "$file_base_url" ]; then
    # Already configured in .env - confirm or keep
    if [ "$can_prompt" = true ]; then
      printf "BASE_URL is already configured (%s). Keep? [Y/n]: " "$file_base_url" >&2
      local response
      IFS= read -r response
      if [[ "$response" =~ ^[Nn]$ ]]; then
        file_base_url=""
      fi
    fi
  fi

  # Prompt for BASE_URL if not set and we're interactive
  if [ -z "$env_base_url" ] && [ -z "$file_base_url" ] && [ "$can_prompt" = true ]; then
    printf "\n" >&2
    printf "BASE_URL (optional - press Enter to use default): " >&2
    local entered_url
    IFS= read -r entered_url

    if [ -n "$entered_url" ]; then
      write_env_key "BASE_URL" "$entered_url"
      log_ok "✓ Saved BASE_URL to $TARGET_DIR/.env"
    else
      log "Using default BASE_URL from configuration"
    fi
  fi
}

# Detect OS and architecture
detect_platform() {
  local os kernel arch

  os="$(uname -s)"
  kernel="$(uname -r)"
  arch="$(uname -m)"

  # Check for WSL
  if grep -qi microsoft /proc/version 2>/dev/null || grep -qi wsl /proc/version 2>/dev/null; then
    log_ok "Detected WSL environment"
    PLATFORM_OS="linux"
  elif [ "$os" = "Linux" ]; then
    log_ok "Detected Linux environment"
    PLATFORM_OS="linux"
  elif [ "$os" = "Darwin" ]; then
    log_ok "Detected macOS environment"
    PLATFORM_OS="darwin"
  else
    die "This installer only supports WSL, Linux, and macOS. Detected: $os"
  fi

  # Check architecture
  if [ "$arch" != "x86_64" ] && [ "$arch" != "amd64" ] && [ "$arch" != "arm64" ]; then
    die "This installer only supports x86_64/amd64/arm64 architecture. Detected: $arch"
  fi

  # Normalize architecture for cosign binary selection
  if [ "$arch" = "x86_64" ] || [ "$arch" = "amd64" ]; then
    PLATFORM_ARCH="amd64"
  elif [ "$arch" = "arm64" ]; then
    PLATFORM_ARCH="arm64"
  fi

  log "Platform: $os $kernel ($arch)"
}

# Check prerequisites
check_prerequisites() {
  local missing=()

  for cmd in curl tar mkdir; do
    if ! command -v "$cmd" >/dev/null 2>&1; then
      missing+=("$cmd")
    fi
  done

  if [ ${#missing[@]} -gt 0 ]; then
    die "Missing required commands: ${missing[*]}. Please install them and try again."
  fi

  log_ok "All prerequisites found"
}

# Detect and install OpenCode CLI if not present
ensure_opencode() {
  # Check if OpenCode is installed
  if command -v opencode >/dev/null 2>&1; then
    local current_version
    current_version="$(opencode --version 2>/dev/null || echo "unknown")"
    log_ok "OpenCode CLI found (version: $current_version)"
    return 0
  fi

  # OpenCode not found - offer to install
  local can_prompt=false
  if [ "$DRY_RUN" != true ] && [ "$NO_PROMPT" != true ] && [ -t 0 ]; then
    can_prompt=true
  fi

  if [ "$DRY_RUN" = true ]; then
    log "Dry run: would install OpenCode CLI"
    return 0
  fi

  if [ "$NO_PROMPT" = true ] && [ "$can_prompt" = false ]; then
    die "OpenCode CLI is not installed and --no-prompt is set. Install OpenCode first: https://opencode.ai"
  fi

  if [ "$can_prompt" = true ]; then
    printf "\n" >&2
    printf "╔══════════════════════════════════════════════════════════════╗\n" >&2
    printf "║  OpenCode CLI Not Found                                     ║\n" >&2
    printf "╠══════════════════════════════════════════════════════════════╣\n" >&2
    printf "║  OpenCode is required to use this kit.                      ║\n" >&2
    printf "║  Install now? [Y/n]:                                        ║\n" >&2
    printf "╚══════════════════════════════════════════════════════════════╝\n" >&2
    printf "\n" >&2

    local response
    printf "Install OpenCode? [Y/n]: " >&2
    IFS= read -r response
    printf "\n" >&2

    if [[ "$response" =~ ^[Nn]$ ]]; then
      die "OpenCode CLI is required. Install from: https://opencode.ai"
    fi
  fi

  # Install OpenCode CLI
  log "Installing OpenCode CLI..."

  local install_script
  install_script="$(mktemp)"

  # Detect platform for installation
  local os arch
  os="$(uname -s)"
  arch="$(uname -m)"

  if [ "$arch" = "x86_64" ] || [ "$arch" = "amd64" ]; then
    arch="x86_64"
  elif [ "$arch" = "arm64" ]; then
    arch="aarch64"
  fi

  # Download and run OpenCode install script
  local opencode_install_url="https://opencode.ai/install"
  
  if ! curl -fsSL "$opencode_install_url" -o "$install_script"; then
    rm -f "$install_script"
    die "Failed to download OpenCode installer"
  fi

  chmod +x "$install_script"

  # Run the installer
  if ! "$install_script" --prefix "$TARGET_DIR/bin" 2>&1; then
    rm -f "$install_script"
    die "OpenCode installation failed"
  fi

  rm -f "$install_script"

  # Add to PATH for current session
  export PATH="$TARGET_DIR/bin:$PATH"

  # Verify installation
  if ! command -v opencode >/dev/null 2>&1; then
    die "OpenCode installed but not found in PATH. Add $TARGET_DIR/bin to your PATH."
  fi

  local installed_version
  installed_version="$(opencode --version 2>/dev/null || echo "unknown")"
  log_ok "OpenCode CLI installed (version: $installed_version)"
}

# Download cosign binary if needed
ensure_cosign() {
  local cosign_bin cosign_url cosign_binary_name

  cosign_bin="$TARGET_DIR/bin/cosign"

  # Determine the correct cosign binary based on platform
  cosign_binary_name="cosign-${PLATFORM_OS}-${PLATFORM_ARCH}"
  cosign_url="https://github.com/sigstore/cosign/releases/download/${COSIGN_VERSION}/${cosign_binary_name}"

  if [ -x "$cosign_bin" ]; then
    echo "$cosign_bin"
    return 0
  fi

  mkdir -p "$TARGET_DIR/bin"
  local tmp
  tmp="$(mktemp)"

  log "Downloading cosign ${COSIGN_VERSION} for ${PLATFORM_OS}/${PLATFORM_ARCH}..."

  if ! curl -fsSL "$cosign_url" -o "$tmp"; then
    rm -f "$tmp"
    die "Failed to download cosign from $cosign_url"
  fi

  # Note: SHA256 verification skipped for non-linux platforms
  # The pinned hash (COSIGN_SHA256) is specifically for cosign-linux-amd64
  if [ "$PLATFORM_OS" = "linux" ] && [ "$PLATFORM_ARCH" = "amd64" ]; then
    local actual_sha
    if command -v sha256sum >/dev/null 2>&1; then
      actual_sha="$(sha256sum "$tmp" | awk '{print $1}')"
    elif command -v shasum >/dev/null 2>&1; then
      actual_sha="$(shasum -a 256 "$tmp" | awk '{print $1}')"
    else
      log_warn "sha256sum/shasum not found, skipping cosign hash verification"
      actual_sha="$COSIGN_SHA256"
    fi

    if [ "$actual_sha" != "$COSIGN_SHA256" ]; then
      rm -f "$tmp"
      die "cosign sha256 mismatch (expected pinned hash)"
    fi
  else
    log_warn "Skipping cosign SHA256 verification for ${PLATFORM_OS}/${PLATFORM_ARCH} (pinned hash is linux-amd64 specific)"
  fi

  if ! chmod +x "$tmp" || ! "$tmp" version >/dev/null 2>&1; then
    rm -f "$tmp"
    die "Downloaded cosign binary is invalid"
  fi

  mv "$tmp" "$cosign_bin"

  log_ok "cosign ${COSIGN_VERSION} ready"
  echo "$cosign_bin"
}

# Verify tarball signature with cosign keyless
verify_tarball() {
  local tarball="$1" bundle="$2" tag="$3" cosign_bin expected_identity

  if [ "$DRY_RUN" = true ]; then
    log "Dry run: would verify signature for $tarball"
    return 0
  fi

  if [ "$SKIP_VERIFY" = "true" ]; then
    log_warn "Signature verification skipped (SKIP_VERIFY=true)"
    return 0
  fi

  log "Verifying tarball signature (cosign keyless bundle)..."
  cosign_bin="$(ensure_cosign)"

  expected_identity="${COSIGN_IDENTITY_PREFIX}${tag}"

  if ! "$cosign_bin" verify-blob \
    --bundle "$bundle" \
    --certificate-identity "$expected_identity" \
    --certificate-oidc-issuer "$COSIGN_OIDC_ISSUER" \
    "$tarball" >/dev/null 2>&1; then
    die "Tarball signature verification failed for $tarball. Set SKIP_VERIFY=true to skip verification."
  fi

  log_ok "Tarball signature verified"
}

validate_tarball_entries() {
  local tarball="$1"

  # Reject absolute paths and any .. path segments (path traversal).
  if tar -tzf "$tarball" | grep -E '^(\/|.*(^|\/)\.\.(\/|$))' >/dev/null 2>&1; then
    die "Tarball contains unsafe paths (absolute or traversal)"
  fi
}

# Download release artifacts
download_release() {
  local tag version_dir manifest_url tarball_url

  # Determine tag (use latest if not specified)
  tag="${1:-latest}"

  if [ "$tag" = "latest" ]; then
    log "Fetching latest release information..."

    # Try to fetch latest release tag from GitHub API
    if [ -n "${GITHUB_TOKEN:-}" ]; then
      tag="$(curl -fsSL -H "Authorization: Bearer \"$GITHUB_TOKEN\"" https://api.github.com/repos/krajh/ai-kit/releases/latest 2>/dev/null | grep '"tag_name"' | head -1 | cut -d'"' -f4)"
    else
      tag="$(curl -fsSL https://api.github.com/repos/krajh/ai-kit/releases/latest 2>/dev/null | grep '"tag_name"' | head -1 | cut -d'"' -f4)"
    fi

    # If API call failed, try using the Atom feed (more stable than HTML scraping)
    if [ -z "$tag" ]; then
      log_warn "GitHub API unavailable, trying releases feed..."
      tag="$(curl -fsSL https://github.com/krajh/ai-kit/releases.atom 2>/dev/null | grep -o '<id>tag:github.com,2008:Repository/[^/]*/[^<]*</id>' | head -1 | sed 's|.*Repository/[^/]*/||; s|</id>||')"
      # Validate tag format to avoid silently using unexpected values if the feed format changes
      if [ -n "$tag" ] && ! [[ "$tag" =~ ^v[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
        log_warn "Unexpected tag format from releases feed: '$tag'; ignoring."
        tag=""
      fi
    fi

    if [ -z "$tag" ]; then
      die "Could not determine latest release tag. Please specify a version explicitly (e.g., ./ai-kit-install install v0.1.3)"
    fi
  fi

  log "Using release tag: $tag"

  version_dir="$VERSIONS_DIR/$tag"
  mkdir -p "$version_dir"

  manifest_url="https://github.com/krajh/ai-kit/releases/download/${tag}/manifest.json"
  tarball_url="https://github.com/krajh/ai-kit/releases/download/${tag}/ai-kit-${tag}.tar.gz"
  local bundle_url
  bundle_url="https://github.com/krajh/ai-kit/releases/download/${tag}/ai-kit-${tag}.bundle.json"

  log "Downloading manifest from $manifest_url..."
  if ! curl -fsSL "$manifest_url" -o "$version_dir/manifest.json"; then
    die "Failed to download manifest"
  fi

  log "Downloading tarball from $tarball_url..."
  if ! curl -fsSL "$tarball_url" -o "$version_dir/ai-kit-${tag}.tar.gz"; then
    die "Failed to download tarball"
  fi

  log "Downloading bundle from $bundle_url..."
  if ! curl -fsSL "$bundle_url" -o "$version_dir/ai-kit-${tag}.bundle.json"; then
    die "Failed to download bundle"
  fi

  # Verify tarball sha256 from manifest (best-effort parse; fail if present and mismatch)
  local expected_sha actual_sha
  expected_sha="$(grep -o '"sha256"\s*:\s*"[a-f0-9]\+"' "$version_dir/manifest.json" | head -1 | cut -d'"' -f4)"
  actual_sha="$(sha256sum "$version_dir/ai-kit-${tag}.tar.gz" | awk '{print $1}')"
  if [ -n "$expected_sha" ] && [ "$expected_sha" != "$actual_sha" ]; then
    die "Tarball sha256 mismatch"
  fi

  log_ok "Release artifacts downloaded to $version_dir"
  echo "$tag"
}

# Extract tarball to version directory
extract_tarball() {
  local tag="$1" version_dir

  version_dir="$VERSIONS_DIR/$tag"

  if [ "$DRY_RUN" = true ]; then
    log "Dry run: would extract tarball to $version_dir"
    return 0
  fi

  verify_tarball "$version_dir/ai-kit-${tag}.tar.gz" "$version_dir/ai-kit-${tag}.bundle.json" "$tag"
  validate_tarball_entries "$version_dir/ai-kit-${tag}.tar.gz"

  log "Extracting tarball..."
  if ! tar -xzf "$version_dir/ai-kit-${tag}.tar.gz" -C "$version_dir"; then
    die "Failed to extract tarball"
  fi

  # Keep versions/<tag>/ clean: remove downloaded artifacts after extraction.
  rm -f \
    "$version_dir/ai-kit-${tag}.tar.gz" \
    "$version_dir/ai-kit-${tag}.bundle.json" \
    "$version_dir/manifest.json" 2>/dev/null || true

  log_ok "Tarball extracted"
}

activate_version() {
  local tag="$1" version_dir
  version_dir="$VERSIONS_DIR/$tag"

  if [ "$DRY_RUN" = true ]; then
    log "Dry run: would activate $tag"
    return 0
  fi

  ln -sfn "$version_dir" "$CURRENT_LINK"
  log_ok "Symlink created: $CURRENT_LINK -> $version_dir"

  # Clean up stale symlinks from pre-v0.3.0 directory renames.
  # (agent -> agents, plugin -> plugins)
  local -a STALE_LINKS=("agent" "plugin")
  for old in "${STALE_LINKS[@]}"; do
    if [ -L "$TARGET_DIR/$old" ]; then
      rm -f "$TARGET_DIR/$old"
      log "Removed stale symlink: $TARGET_DIR/$old"
    fi
  done

  # Expose kit files at ~/.config/opencode/* via symlinks.
  for item in "${KIT_LINK_ITEMS[@]}"; do
    if [ -e "$TARGET_DIR/$item" ] && [ ! -L "$TARGET_DIR/$item" ]; then
      log_warn "Not overwriting existing non-symlink: $TARGET_DIR/$item"
      continue
    fi

    rm -rf "$TARGET_DIR/$item" 2>/dev/null || true
    ln -sfn "$CURRENT_LINK/$item" "$TARGET_DIR/$item"
  done
}

# Preserve .env and local/ directories
preserve_local_state() {
  local backup_env backup_local

  if [ ! -d "$TARGET_DIR" ]; then
    return 0
  fi

  backup_env="$(mktemp)"
  backup_local="$(mktemp -d)"

  if [ -f "$TARGET_DIR/.env" ]; then
    log "Preserving .env file..."
    cp "$TARGET_DIR/.env" "$backup_env"
  fi

  if [ -d "$TARGET_DIR/local" ]; then
    log "Preserving local/ directory..."
    cp -r "$TARGET_DIR/local" "$backup_local/"
  fi

  echo "$backup_env:$backup_local"
}

# Restore .env and local/ directories
restore_local_state() {
  local backup_info="$1" backup_env backup_local

  IFS=':' read -r backup_env backup_local <<<"$backup_info"

  if [ -f "$backup_env" ] && [ -s "$backup_env" ]; then
    log "Restoring .env file..."
    cp "$backup_env" "$TARGET_DIR/.env"
    rm -f "$backup_env"
  fi

  if [ -d "$backup_local/local" ]; then
    log "Restoring local/ directory..."
    cp -r "$backup_local/local" "$TARGET_DIR/"
    rm -rf "$backup_local"
  fi
}

# ---------------------------------------------------------------------------
# Personalisation-safe update helpers
# ---------------------------------------------------------------------------

# Cross-platform SHA256 helper (Linux: sha256sum, macOS: shasum -a 256)
file_sha256() {
  local file="$1"
  if command -v sha256sum >/dev/null 2>&1; then
    sha256sum "$file" | awk '{print $1}'
  elif command -v shasum >/dev/null 2>&1; then
    shasum -a 256 "$file" | awk '{print $1}'
  else
    die "Neither sha256sum nor shasum found"
  fi
}

# Compute SHA256 hashes of all files in a version directory and store them
# in .ai-kit-manifest.json. Called immediately after extraction so the hashes
# reflect the original kit state *before* any user personalisation.
compute_manifest() {
  local version_dir="$1"
  local manifest_file="$version_dir/$MANIFEST_FILE"

  if [ "$DRY_RUN" = true ]; then
    log "Dry run: would compute manifest for $version_dir"
    return 0
  fi

  local version
  version="$(basename "$version_dir")"
  version="${version#v}"

  local installed_at
  installed_at="$(date -u +%Y-%m-%dT%H:%M:%SZ)"

  local temp_file
  temp_file="$(mktemp)"

  {
    printf '{\n'
    printf '  "version": "%s",\n' "$version"
    printf '  "installedAt": "%s",\n' "$installed_at"
    printf '  "installedVia": "npm",\n'
    printf '  "files": {'
  } >"$temp_file"

  local first=true
  (
    cd "$version_dir" || exit 1
    find . -type f ! -name "$MANIFEST_FILE" -print0 |
      sort -z |
      while IFS= read -r -d '' f; do
        local rel
        rel="${f#./}"
        local hash
        hash="$(file_sha256 "$f")"
        if [ "$first" = true ]; then
          first=false
        else
          printf ',' >>"$temp_file"
        fi
        printf '\n    "%s": {"category":"managed","installedHash":"%s","sourceHash":"%s"}' \
          "$rel" "$hash" "$hash" >>"$temp_file"
      done
  )

  {
    printf '\n  }\n}\n'
  } >>"$temp_file"

  mv "$temp_file" "$manifest_file"
  local file_count
  file_count="$(jq -r '.files | length' "$manifest_file" 2>/dev/null || echo "?")"
  log_ok "Manifest written ($file_count files)"
}

# Compare current version files against stored manifest.
# Outputs lines:  M <relpath>  (modified)   A <relpath>  (added by user)
# Returns 0 if personalised files were found, 1 otherwise.
detect_user_modifications() {
  local version_dir="$1"
  local manifest_file="$version_dir/$MANIFEST_FILE"

  if [ ! -f "$manifest_file" ]; then
    log_warn "No manifest found in current version."
    log_warn "Cannot detect personalisations (version predates this feature)."
    return 1
  fi

  local found=false

  # Check each tracked file for modification
  local keys
  keys="$(jq -r '.files | keys[]' "$manifest_file" 2>/dev/null || true)"
  if [ -n "$keys" ]; then
    while IFS= read -r rel; do
      [ -z "$rel" ] && continue
      local file_abs="$version_dir/$rel"
      if [ ! -f "$file_abs" ]; then
        continue
      fi
      local expected_hash actual_hash
      expected_hash="$(jq -r --arg p "$rel" '.files[$p].installedHash' "$manifest_file")"
      actual_hash="$(file_sha256 "$file_abs")"
      if [ "$expected_hash" != "$actual_hash" ]; then
        printf "M %s\n" "$rel"
        found=true
      fi
    done <<<"$keys"
  fi

  # Detect user-added files (not in the original manifest)
  (
    cd "$version_dir" || exit 1
    find . -type f ! -name "$MANIFEST_FILE" -print0 |
      sort -z |
      while IFS= read -r -d '' f; do
        local rel
        rel="${f#./}"
        if ! jq -e --arg p "$rel" '.files[$p]' "$manifest_file" >/dev/null 2>&1; then
          printf "A %s\n" "$rel"
          found=true
        fi
      done
  )

  if [ "$found" = true ]; then
    return 0
  fi
  return 1
}

# Copy user-modified/added files into a temporary stash directory.
stash_modifications() {
  local version_dir="$1"
  local stash_dir="$2"

  mkdir -p "$stash_dir"

  while IFS= read -r line; do
    [ -z "$line" ] && continue
    local type file_rel
    type="${line%% *}"
    file_rel="${line#* }"
    local src="$version_dir/$file_rel"
    local dst="$stash_dir/$file_rel"

    mkdir -p "$(dirname "$dst")"
    cp "$src" "$dst"

    case "$type" in
    M) log "  Stashed modified: $file_rel" ;;
    A) log "  Stashed added:    $file_rel" ;;
    esac
  done
}

# Prompt the user to resolve a single conflict (interactive).
# Falls back to keeping the new version with a .user sidecar in non-interactive mode.
handle_conflict() {
  local rel_path="$1"
  local user_file="$2"
  local new_file="$3"

  if [ "$NO_PROMPT" = true ] || [ ! -t 0 ]; then
    cp "$user_file" "${new_file}.user"
    log_warn "  Conflict: $rel_path (kept new version; your version saved as ${rel_path}.user)"
    return
  fi

  log_warn "  Conflict: $rel_path"
  log "  Both your version and the new release modified this file."
  printf "  [k]eep yours / [o]verwrite with new / [d]iff / [s]kip? " >&2

  while true; do
    local choice
    IFS= read -r -n 1 choice
    printf "\n" >&2

    case "$choice" in
    k | K)
      cp "$user_file" "$new_file"
      log_ok "  Kept your version: $rel_path"
      break
      ;;
    o | O)
      log_ok "  Using new version: $rel_path"
      break
      ;;
    d | D)
      if command -v diff >/dev/null 2>&1; then
        printf "\n" >&2
        diff --color=auto -u "$new_file" "$user_file" >&2 || true
        printf "\n" >&2
      else
        log_warn "  diff not available"
      fi
      printf "  [k]eep yours / [o]verwrite with new / [s]kip? " >&2
      ;;
    s | S)
      cp "$user_file" "${new_file}.user"
      log "  Skipped: $rel_path (your version saved as ${rel_path}.user)"
      break
      ;;
    *)
      printf "  [k]eep / [o]verwrite / [d]iff / [s]kip? " >&2
      ;;
    esac
  done
}

# Reapply stashed personalisations onto the new version directory.
# Uses a 3-way strategy:
#   old original == new file  →  only user changed → apply user's version
#   old original != new file  →  both changed      → conflict
#   file not in new version   →  user-added         → copy over
reapply_modifications() {
  local new_version_dir="$1"
  local stash_dir="$2"
  local old_manifest_file="$3"

  local applied=0 conflicts=0 added=0

  while IFS= read -r stashed_file; do
    local rel_path="${stashed_file#"$stash_dir"/}"
    local new_file="$new_version_dir/$rel_path"

    if [ ! -f "$new_file" ]; then
      # File doesn't exist in new version — user-added, just copy it over
      mkdir -p "$(dirname "$new_file")"
      cp "$stashed_file" "$new_file"
      log_ok "  Restored user-added: $rel_path"
      added=$((added + 1))
      continue
    fi

    # File exists in both. Was it also changed in the new release?
    local old_hash new_hash
    old_hash="$(jq -r --arg p "$rel_path" '.files[$p].installedHash' "$old_manifest_file" 2>/dev/null)"
    new_hash="$(file_sha256 "$new_file")"

    if [ -z "$old_hash" ] || [ "$old_hash" = "null" ]; then
      # File didn't exist in old version but exists in both user stash and new
      handle_conflict "$rel_path" "$stashed_file" "$new_file"
      conflicts=$((conflicts + 1))
      continue
    fi

    if [ "$old_hash" = "$new_hash" ]; then
      # New release didn't change this file — safe to apply user's version
      cp "$stashed_file" "$new_file"
      log_ok "  Applied personalisation: $rel_path"
      applied=$((applied + 1))
    else
      # Both user and new release modified this file — conflict
      handle_conflict "$rel_path" "$stashed_file" "$new_file"
      conflicts=$((conflicts + 1))
    fi
  done < <(find "$stash_dir" -type f)

  log "Personalisation summary: $applied applied, $added user-added restored, $conflicts conflicts"
}

# Install fresh configuration
cmd_install() {
  local tag version_dir

  show_logo
  echo ""
  log "Starting fresh installation..."
  detect_platform
  check_prerequisites

  # Check and install OpenCode if needed
  ensure_opencode

  if [ -d "$TARGET_DIR" ]; then
    die "Installation directory already exists at $TARGET_DIR. Use 'update' to refresh or remove the directory manually."
  fi

  # Download release
  tag="$(download_release "${1:-latest}")"
  version_dir="$VERSIONS_DIR/$tag"

  # Extract
  extract_tarball "$tag"

  # Store baseline manifest so future updates can detect personalizations
  compute_manifest "$version_dir"

  mkdir -p "$TARGET_DIR"
  activate_version "$tag"

  ensure_aitoolingkey

  log_ok "Installation complete at $TARGET_DIR"
  log "Run 'opencode' to begin using the configuration."
}

# Update existing installation
cmd_update() {
  local tag backup_info version_dir
  local current_version_dir="" stash_dir="" old_manifest_backup="" modifications=""

  show_logo
  echo ""
  log "Starting update..."
  detect_platform
  check_prerequisites

  # Check and install OpenCode if needed
  ensure_opencode

  if [ ! -d "$TARGET_DIR" ]; then
    die "No existing installation found at $TARGET_DIR. Use 'install' for fresh installation."
  fi

  # Backup existing config
  if [ "$DRY_RUN" = false ]; then
    mkdir -p "$BACKUP_ROOT"
    log "Archiving existing configuration to $BACKUP_PATH"
    cp -r "$TARGET_DIR" "$BACKUP_PATH"
  else
    log "Dry run: would archive to $BACKUP_PATH"
  fi

  # ── Personalisation detection ──────────────────────────────────────
  if [ -L "$CURRENT_LINK" ]; then
    current_version_dir="$(readlink -f "$CURRENT_LINK")"
  fi

  if [ -n "$current_version_dir" ] && [ -f "$current_version_dir/$MANIFEST_FILE" ]; then
    modifications="$(detect_user_modifications "$current_version_dir")"
    if [ -n "$modifications" ]; then
      local mod_count
      mod_count="$(echo "$modifications" | wc -l | tr -d ' ')"
      log "Detected $mod_count personalised file(s):"
      echo "$modifications" | while IFS= read -r line; do
        log "  $line"
      done

      stash_dir="$(mktemp -d)"
      stash_modifications "$current_version_dir" "$stash_dir" "$modifications"

      # Keep a copy of the old manifest for 3-way conflict detection
      old_manifest_backup="$(mktemp)"
      cp "$current_version_dir/$MANIFEST_FILE" "$old_manifest_backup"
    else
      log "No personalised files detected — clean update."
    fi
  elif [ -n "$current_version_dir" ]; then
    log_warn "No manifest in current version. Personalisation detection unavailable."
    log_warn "Your changes (if any) inside the version directory will not be preserved."
    log_warn "Future updates will support this after this upgrade completes."
  fi

  # Preserve local state (.env, local/)
  backup_info="$(preserve_local_state)"

  # Download release
  tag="$(download_release "${1:-latest}")"
  version_dir="$VERSIONS_DIR/$tag"

  # Extract
  extract_tarball "$tag"

  # Store baseline manifest for the new version BEFORE applying personalisations
  compute_manifest "$version_dir"

  # ── Reapply personalisations ───────────────────────────────────────
  if [ -n "$stash_dir" ] && [ -d "$stash_dir" ]; then
    log "Reapplying personalised files to $tag..."
    reapply_modifications "$version_dir" "$stash_dir" "$old_manifest_backup"
    rm -rf "$stash_dir"
    rm -f "$old_manifest_backup"
  fi

  # Activate
  activate_version "$tag"

  # Restore local state
  if [ "$DRY_RUN" = false ]; then
    restore_local_state "$backup_info"
  fi

  ensure_aitoolingkey

  log_ok "Update complete"
  log "Run 'opencode' to use the updated configuration."
}

# Show installation status
cmd_status() {
  if [ ! -d "$TARGET_DIR" ]; then
    log "No installation found at $TARGET_DIR"
    return 1
  fi

  log "Installation status:"
  log "  Location: $TARGET_DIR"

  if [ -L "$CURRENT_LINK" ]; then
    local current_version
    current_version="$(readlink "$CURRENT_LINK" | xargs basename)"
    log "  Current version: $current_version"
  fi

  if [ -d "$VERSIONS_DIR" ]; then
    log "  Available versions:"
    for version_dir in "$VERSIONS_DIR"/*; do
      if [ -d "$version_dir" ]; then
        local version
        version="$(basename "$version_dir")"
        log "    - $version"
      fi
    done
  fi

  if [ -f "$TARGET_DIR/.env" ]; then
    log_ok ".env file is present"
  fi

  if [ -d "$TARGET_DIR/local" ]; then
    log_ok "local/ directory is present"
  fi

  if [ -d "$TARGET_DIR/$INCOMING_DIR" ]; then
    local incoming_count
    incoming_count="$((
      find "$TARGET_DIR/$INCOMING_DIR" -type f 2>/dev/null | wc -l | tr -d ' '
    ))"
    if [ "$incoming_count" -eq 0 ]; then
      log "No pending conflicts."
    else
      log_warn "Pending conflicts:"
      find "$TARGET_DIR/$INCOMING_DIR" -type f 2>/dev/null | while IFS= read -r file; do
        log "  ${file#"$TARGET_DIR/"}"
      done
    fi
  else
    log "No pending conflicts."
  fi
}

# Rollback to previous version
cmd_rollback() {
  local latest_backup

  if [ ! -d "$BACKUP_ROOT" ]; then
    die "No backups found at $BACKUP_ROOT"
  fi

  latest_backup="$(ls -td "$BACKUP_ROOT"/ai-kit-* 2>/dev/null | head -1)"

  if [ -z "$latest_backup" ]; then
    die "No backups found"
  fi

  log "Rolling back to: $latest_backup"

  if [ "$DRY_RUN" = false ]; then
    rm -rf "$TARGET_DIR"
    cp -r "$latest_backup" "$TARGET_DIR"
    log_ok "Rollback complete"
  else
    log "Dry run: would restore from $latest_backup"
  fi
}

cmd_resolve() {
  local mode="${1:-}"

  if [ ! -d "$TARGET_DIR" ]; then
    log "No installation found at $TARGET_DIR"
    return 1
  fi

  if [ "$mode" != "--accept-incoming" ] && [ "$mode" != "--keep-mine" ]; then
    log_error "Usage: ai-kit-install resolve --accept-incoming|--keep-mine"
    return 1
  fi

  local incoming_path="$TARGET_DIR/$INCOMING_DIR"
  if [ ! -d "$incoming_path" ]; then
    log "No pending conflicts."
    return 0
  fi

  local pending_files
  pending_files="$(find "$incoming_path" -type f 2>/dev/null || true)"
  if [ -z "$pending_files" ]; then
    log "No pending conflicts."
    return 0
  fi

  local current_version_dir=""
  if [ -L "$CURRENT_LINK" ]; then
    current_version_dir="$(readlink -f "$CURRENT_LINK")"
  fi

  local manifest_file=""
  if [ -n "$current_version_dir" ] && [ -f "$current_version_dir/$MANIFEST_FILE" ]; then
    manifest_file="$current_version_dir/$MANIFEST_FILE"
  fi

  while IFS= read -r incoming_file; do
    [ -z "$incoming_file" ] && continue
    local rel_path
    rel_path="${incoming_file#"$incoming_path/"}"
    local dest_path="$TARGET_DIR/$rel_path"

    if [ "$mode" = "--accept-incoming" ]; then
      mkdir -p "$(dirname "$dest_path")"
      cp "$incoming_file" "$dest_path"

      if [ -n "$manifest_file" ]; then
        local hash
        hash="$(file_sha256 "$dest_path")"
        jq --arg p "$rel_path" --arg h "$hash" \
          '.files[$p].installedHash = $h | .files[$p].sourceHash = $h' \
          "$manifest_file" >"$manifest_file.tmp" && mv "$manifest_file.tmp" "$manifest_file"
      fi

      log_ok "Accepted incoming: $rel_path"
    else
      log_ok "Kept mine: $rel_path"
    fi

    rm -f "$incoming_file"
  done <<<"$pending_files"

  find "$incoming_path" -type d -empty -delete 2>/dev/null || true
}

# Dry run mode
cmd_dry_run() {
  DRY_RUN=true
  log "Running in DRY RUN mode - no changes will be made"

  detect_platform
  check_prerequisites

  if [ -d "$TARGET_DIR" ]; then
    log "Existing installation found at $TARGET_DIR"
    cmd_update "${1:-latest}"
  else
    log "No existing installation found"
    cmd_install "${1:-latest}"
  fi

  log_ok "Dry run complete"
}

# Show help
show_help() {
  cat <<EOF
AI Kit Installer (OpenCode configuration)

USAGE:
  ai-kit-install <command> [options]

COMMANDS:
  install [TAG]     Fresh installation (default: latest release)
  update [TAG]      Update existing installation (default: latest release)
  status            Show installation status
  rollback          Restore previous backup
  resolve           Resolve staged conflicts (accept incoming or keep mine)
  dry-run [TAG]     Simulate installation without making changes

OPTIONS:
  -v, --verbose     Enable verbose output
  -h, --help        Show this help message
  --no-prompt        Do not prompt for AITOOLINGKEY (fail if missing)

EXAMPLES:
  ai-kit-install install
  ai-kit-install update
  ai-kit-install status
  ai-kit-install rollback
  ai-kit-install resolve --accept-incoming
  ai-kit-install resolve --keep-mine
  ai-kit-install dry-run

ENVIRONMENT:
  WSL/Linux/macOS (x86_64/amd64/arm64 architecture required)
  Requires: curl, tar, mkdir
  AITOOLINGKEY: API key (will prompt if missing, or set via env / ~/.config/opencode/.env)
  BASE_URL: Optional base URL override (set via env / ~/.config/opencode/.env)

NOTES:
  When using 'curl | bash', export variables before the pipe:
    export AITOOLINGKEY="your-key" [BASE_URL="https://api.example.com"]
    curl -fsSL ... | bash

PERSONALISATION SAFETY:
  The 'update' command automatically detects files you've modified or added
  inside the active version directory. Your changes are stashed, the new
  version is applied, and your personalisations are reapplied via 3-way merge.

  Interactive mode:  conflicts prompt [k]eep/[o]verwrite/[d]iff/[s]kip
  Non-interactive:   new version wins; your file saved as <name>.user

  Files outside the version directory (.env, local/) are always preserved.

EOF
}

# Main entry point
main() {
  case "${COMMAND}" in
  install)
    cmd_install "${TAG:-latest}"
    ;;
  update)
    cmd_update "${TAG:-latest}"
    ;;
  status)
    cmd_status
    ;;
  rollback)
    cmd_rollback
    ;;
  resolve)
    cmd_resolve "${POSITIONAL[1]:-}"
    ;;
  dry-run)
    cmd_dry_run "${TAG:-latest}"
    ;;
  -h | --help | help)
    show_help
    ;;
  *)
    log_error "Unknown command: $COMMAND"
    show_help
    exit 1
    ;;
  esac
}

main "$@"
