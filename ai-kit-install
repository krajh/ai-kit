ensure_opencode() {
  # Check if OpenCode is installed
  if command -v opencode >/dev/null 2>&1; then
    local current_version
    current_version="$(opencode --version 2>/dev/null || echo "unknown")"
    log_ok "OpenCode CLI found (version: $current_version)"
