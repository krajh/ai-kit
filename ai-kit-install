# Main entry point
main() {
  case "${COMMAND}" in
  install)
    cmd_install "${TAG:-latest}"
    ;;
  update)
    cmd_update "${TAG:-latest}"
    ;;
  status)
    cmd_status
    ;;
  rollback)
    cmd_rollback
    ;;
  resolve)
    cmd_resolve "${POSITIONAL[1]:-}"
    ;;
  dry-run)
    cmd_dry_run "${TAG:-latest}"
    ;;
  -h | --help | help)
    show_help
    ;;
  *)
    log_error "Unknown command: $COMMAND"
    show_help
    exit 1
    ;;
  esac
}

main "$@"
