          "id": "grok-code-fast-1",
          "name": "Grok Code Fast 1",
          "temperature": true
        }
      }
    }
  },
  "model": "github-copilot/gpt-5.2-codex",
  "small_model": "github-copilot/claude-haiku-4.5",
  "instructions": [
    "protocols/TOOL_USAGE_GUIDE.md",
    "protocols/DELEGATION_PROTOCOLS.md"
  ],
  "watcher": {
    "ignore": [
      "node_modules/**",
      "venv/**",
      ".git/**",
      "dist/**",
      "build/**",
      "*.log",
      ".DS_Store",
      "qdrant_storage/**",
      ".ruff_cache/**",
      "external/context-db-mcp/venv/**"
    ]
  },
  "permission": "allow",
  "compaction": {
    "auto": true,
    "prune": true
  },
  "agent": {
    "coordinator": {
      "description": "Coordination lead (user-defined). Choose the coordinator persona that fits your team.",
      "mode": "primary",
      "temperature": 0.2
    },
    "strategist": {
      "description": "Systems architect for planning and decisions",
      "mode": "subagent",
      "model": "github-copilot/gpt-5.2-codex",
      "temperature": 0.3
    },
    "implementer": {
      "description": "Implementation specialist for disciplined execution",
      "mode": "subagent",
      "model": "github-copilot/claude-haiku-4.5",
      "temperature": 0.4
    },
    "reviewer": {
      "description": "Code and documentation reviewer for quality assurance",
      "mode": "subagent",
      "model": "github-copilot/claude-sonnet-4.5",
      "temperature": 0.2
    },
    "research": {
      "description": "Research lead for discovery and requirements",
      "mode": "subagent",
      "model": "github-copilot/gpt-5.2",
      "temperature": 0.2
    },
    "architect": {
      "description": "Big-picture architect who shapes roadmaps and trade-offs",
      "mode": "subagent",
      "model": "github-copilot/gpt-5.2",
      "temperature": 0.3
    }
  }
}
