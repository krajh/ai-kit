{
  "$schema": "https://opencode.ai/config.json",
  "theme": "kanagawa",
  "autoupdate": true,
  "default_agent": "coordinator",
  "plugin": [
    "plugins/ai-kit-updater.ts",
    "@howaboua/opencode-roadmap-plugin@latest",
    "@tarquinen/opencode-dcp@latest",
    "opencode-mem@2.11.3"
  ],
  "share": "manual",
  "tui": {
    "scroll_speed": 3
  },
  "provider": {
    "aitooling": {
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "https://litellm.aitooling.mgsops.net",
        "apiKey": "{env:AITOOLINGKEY}"
      },
      "models": {
        "azure/gpt-4.1": {
          "id": "gpt-4.1",
          "name": "GPT 4.1",
          "temperature": true
        },
        "azure/gpt-5.1-codex": {
          "id": "gpt-5.1-codex",
          "name": "GPT 5.1 Codex",
          "temperature": true
        },
        "azure/gpt-5.1-codex-mini": {
          "id": "gpt-5.1-codex-mini",
          "name": "GPT 5.1 Codex Mini",
          "temperature": true
        },
        "azure/gpt-5.1": {
          "id": "gpt-5.1",
          "name": "GPT 5.1",
          "temperature": true
        },
        "azure/gpt-5.2": {
          "id": "gpt-5.2",
          "name": "GPT 5.2",
          "temperature": true
        },
        "ant-claude-sonnet-4-5": {
          "id": "ant-claude-sonnet-4-5",
          "name": "Claude Sonnet 4.5",
          "temperature": true
        },
        "claude-haiku-4-5-20251001": {
          "id": "claude-haiku-4-5-20251001",
          "name": "Claude Haiku 4.5",
          "temperature": true
        },
        "claude-haiku-4-5-20250929": {
          "id": "claude-haiku-4-5-20250929",
          "name": "Claude Haiku 4.5",
          "temperature": true
        }
      }
    },
    "github-copilot": {
      "models": {
        "claude-haiku-4.5": {
          "id": "claude-haiku-4.5",
          "name": "Claude Haiku 4.5",
          "temperature": true
        },
        "claude-opus-4.5": {
          "id": "claude-opus-4.5",
          "name": "Claude Opus 4.5",
          "temperature": true
        },
        "claude-opus-41": {
          "id": "claude-opus-41",
          "name": "Claude Opus 4.1",
          "temperature": true
        },
        "claude-sonnet-4": {
          "id": "claude-sonnet-4",
          "name": "Claude Sonnet 4",
          "temperature": true
        },
        "claude-sonnet-4.5": {
          "id": "claude-sonnet-4.5",
          "name": "Claude Sonnet 4.5",
          "temperature": true
        },
        "gemini-2.5-pro": {
          "id": "gemini-2.5-pro",
          "name": "Gemini 2.5 Pro",
          "temperature": true
        },
        "gemini-3-flash-preview": {
          "id": "gemini-3-flash-preview",
          "name": "Gemini 3 Flash",
          "temperature": true
        },
        "gemini-3-pro-preview": {
          "id": "gemini-3-pro-preview",
          "name": "Gemini 3 Pro Preview",
          "temperature": true
        },
        "gpt-4.1": {
          "id": "gpt-4.1",
          "name": "GPT-4.1",
          "temperature": true
        },
        "gpt-4o": {
          "id": "gpt-4o",
          "name": "GPT-4o",
          "temperature": true
        },
        "gpt-5": {
          "id": "gpt-5",
          "name": "GPT-5",
          "temperature": true
        },
        "gpt-5-mini": {
          "id": "gpt-5-mini",
          "name": "GPT-5 mini",
          "temperature": true
        },
        "gpt-5.1": {
          "id": "gpt-5.1",
          "name": "GPT-5.1",
          "temperature": false
        },
        "gpt-5.1-codex": {
          "id": "gpt-5.1-codex",
          "name": "GPT-5.1-Codex",
          "temperature": false
        },
        "gpt-5.1-codex-max": {
          "id": "gpt-5.1-codex-max",
          "name": "GPT-5.1-Codex-max",
          "temperature": false
        },
        "gpt-5.1-codex-mini": {
          "id": "gpt-5.1-codex-mini",
          "name": "GPT-5.1-Codex-mini",
          "temperature": false
        },
        "gpt-5.2": {
          "id": "gpt-5.2",
          "name": "GPT-5.2",
          "temperature": false
        },
        "gpt-5.2-codex": {
          "id": "gpt-5.2-codex",
          "name": "GPT-5.2-Codex",
          "temperature": false
        },
