  "instructions": [
    "AGENTS.md"
  ],
  "watcher": {
    "ignore": [
      "node_modules/**",
      "venv/**",
      ".git/**",
      "dist/**",
      "build/**",
      "*.log",
      ".DS_Store",
      "qdrant_storage/**",
      ".ruff_cache/**",
      "external/context-db-mcp/venv/**"
    ]
  },
  "permission": {
    "webfetch": "deny"
  },
  "compaction": {
    "auto": true,
    "prune": true
  },
  "agent": {
    "coordinator": {
      "description": "Coordination lead (user-defined). Choose the coordinator persona that fits your team. Uses verify-loop for Definition of Done enforcement before marking work complete.",
      "mode": "primary",
      "temperature": 0.2
    },
    "strategist": {
      "description": "Systems architect for planning and decisions. Uses verify-loop to validate architectural compliance and F2/F3 Crimson Seal reviews.",
      "mode": "subagent",
      "model": "github-copilot/claude-opus-4.6",
      "temperature": 0.3,
      "permission": {
        "bash": "deny",
        "write": "deny",
        "edit": "deny"
      }
    },
    "implementer": {
      "description": "Implementation specialist for disciplined execution. Runs verify-loop before committing; uses --spec for semantic gates on F2/F3 work.",
      "mode": "subagent",
      "model": "github-copilot/gpt-5.3-codex",
      "temperature": 0.4,
      "permission": {
        "webfetch": "allow"
      }
    },
    "reviewer": {
      "description": "Code and documentation reviewer for quality assurance. Uses verify-loop for quality gates; performs Guillotine reviews for F2/F3 Crimson Seal compliance.",
      "mode": "subagent",
      "model": "github-copilot/claude-sonnet-4.6",
      "temperature": 0.2,
      "permission": {
        "bash": "deny",
        "write": "deny",
        "edit": "deny"
      }
    },
    "research": {
      "description": "Research lead for discovery and requirements. Uses verify-loop to validate research artifacts and documentation compliance.",
      "mode": "subagent",
      "model": "github-copilot/gpt-5.4",
      "temperature": 0.2,
      "permission": {
        "webfetch": "allow",
        "bash": "deny",
        "write": "deny",
        "edit": "deny"
      }
    },
    "architect": {
      "description": "Big-picture architect who shapes roadmaps and trade-offs. Uses verify-loop for design compliance validation and F2/F3 Crimson Seal gates.",
      "mode": "subagent",
      "model": "github-copilot/claude-opus-4.6",
      "temperature": 0.3,
      "permission": {
        "bash": "deny",
        "write": "deny",
        "edit": "deny"
      }
    }
  }
