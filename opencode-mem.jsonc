{
  // OpenCode Memory Plugin Configuration (v2.7.3)
  // Official Documentation: https://github.com/tickernelz/opencode-mem/wiki/Configuration-Guide
  // ============================================================================
  // STORAGE SETTINGS
  // ============================================================================
  "storagePath": "~/.opencode-mem/data",
  "maxVectorsPerShard": 50000,
  // ============================================================================
  // EMBEDDING SETTINGS
  // ============================================================================
  // Using local model (no API cost for embeddings)
  "embeddingModel": "Xenova/nomic-embed-text-v1",
  "embeddingDimensions": 768,
  "embeddingApiUrl": "",
  "embeddingApiKey": "",
  // ============================================================================
  // WEB SERVER SETTINGS
  // ============================================================================
  "webServerEnabled": true,
  "webServerPort": 4748,
  "webServerHost": "127.0.0.1",
  // ============================================================================
  // AUTO-CAPTURE SETTINGS
  // ============================================================================
  "autoCaptureEnabled": true,
  "memoryProvider": "openai-chat",
  "memoryModel": "gpt-4.1",
  "memoryApiUrl": "https://litellm.aitooling.mgsops.net",
  // Set your LiteLLM / OpenAI-compatible API key here or via the
  // OPENCODE_MEM_API_KEY environment variable. Do not commit real keys.
  "memoryApiKey": "",
  // User profile analysis (every 10 new memories)
  "userProfileAnalysisInterval": 10,
  "userProfileMaxPreferences": 20,
  "userProfileMaxPatterns": 15,
  "userProfileMaxWorkflows": 10,
  "userProfileConfidenceDecayDays": 30,
  "userProfileChangelogRetentionCount": 5,
  // Auto-capture tuning
  "autoCaptureMaxIterations": 5,
  "autoCaptureIterationTimeout": 30000,
  // ============================================================================
  // SEARCH SETTINGS
  // ============================================================================
  "similarityThreshold": 0.65,
  "maxMemories": 10,
  // ============================================================================
  // MAINTENANCE SETTINGS
  // ============================================================================
  "autoCleanupEnabled": true,
  "autoCleanupRetentionDays": 30,
  "deduplicationEnabled": true,
  "deduplicationSimilarityThreshold": 0.9,
  // ============================================================================
  // ADVANCED SETTINGS
  // ============================================================================
  "injectProfile": true,
  "keywordPatterns": [],
  "containerTagPrefix": "opencode",
  "maxProfileItems": 5,
}
